{# Cisco IOS-XE/IOS Base Configuration Template #}
{# ============================================== #}

{# Global Configuration #}
{% if global %}
hostname {{ global.hostname }}
{% if 'domain_name' in global and global.domain_name %}
ip domain-name {{ global.domain_name }}
{% endif %}
{% if 'enable_secret' in global and global.enable_secret %}
enable secret {{ global.enable_secret }}
{% endif %}

{# Banner #}
{% if 'banner_motd' in global and global.banner_motd %}
banner motd ^
{{ global.banner_motd }}
^
{% endif %}

{# Timezone & NTP #}
{% if 'timezone' in global and global.timezone %}
clock timezone {{ global.timezone }}
{% endif %}
{% for ntp in global.ntp_servers | default([]) %}
ntp server {{ ntp }}
{% endfor %}

{# DNS #}
{% for dns in global.dns_servers | default([]) %}
ip name-server {{ dns }}
{% endfor %}

{# Logging #}
{% for log_server in global.logging_servers | default([]) %}
logging host {{ log_server }}
{% endfor %}

{# SNMP #}
{% if 'snmp' in global and global.snmp %}
{% if 'enabled' in global.snmp and global.snmp.enabled %}
{% include '_snmp.j2' %}
{% endif %}
{% endif %}

{# AAA #}
{% if 'aaa' in global and global.aaa %}
{% if 'enabled' in global.aaa and global.aaa.enabled %}
{% include '_aaa.j2' %}
{% endif %}
{% endif %}

{# Users #}
{% for user in global.users | default([]) %}
username {{ user.username }} privilege {{ user.privilege | default(15) }} secret {{ user.secret }}
{% if user.ssh_key %}
ip ssh pubkey-chain
  username {{ user.username }}
    key-string
{{ user.ssh_key | indent(6, first=true) }}
    exit
  exit
{% endif %}
{% endfor %}

{% endif %}{# end global #}

{# Layer 2 Configuration #}
{% if l2 %}
{% include '_l2.j2' %}
{% endif %}

{# Layer 3 Configuration #}
{% if l3 %}
{% include '_l3.j2' %}
{% endif %}

{# VXLAN / EVPN Configuration #}
{% if vxlan and vxlan.enabled %}
{% include '_vxlan.j2' %}
{% endif %}

{# ACLs #}
{% if acls %}
{% include '_acls.j2' %}
{% endif %}

!
end
