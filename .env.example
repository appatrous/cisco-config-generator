# ============================================================================
# CISCO CONFIG GENERATOR - ENVIRONMENT CONFIGURATION
# ============================================================================
#
# SECURITY WARNING:
# - NEVER commit .env file to version control!
# - Generate secure random values for production using:
#   python utils/generate_secrets.py --env
# - All SECRET_KEY values MUST be changed in production!
#
# ============================================================================

# ============================================================================
# Flask Application Configuration
# ============================================================================

# Environment: development, production, testing
FLASK_ENV=development

# Enable debug mode (MUST be False in production!)
FLASK_DEBUG=True

# Secret key for Flask sessions and CSRF protection
# CRITICAL: Generate a secure random value for production!
# Generate with: python utils/generate_secrets.py
SECRET_KEY=CHANGE_ME_TO_SECURE_RANDOM_VALUE_IN_PRODUCTION

# Session lifetime in seconds (default: 3600 = 1 hour)
SESSION_LIFETIME=3600

# Maximum upload file size in bytes (default: 16777216 = 16MB)
MAX_UPLOAD_SIZE=16777216

# Upload folder path
UPLOAD_FOLDER=uploads

# Configuration template directory
CONFIG_TEMPLATE_DIR=config_templates

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection URL format:
# postgresql://username:password@host:port/database
# For Docker: host is 'postgres' (service name)
# For local: host is 'localhost'
DATABASE_URL=postgresql://netconfig:netconfig@postgres:5432/cisco_config_generator

# For local development (without Docker):
# DATABASE_URL=postgresql://netconfig:netconfig@localhost:5432/cisco_config_generator

# ============================================================================
# JWT Authentication Configuration
# ============================================================================

# Secret key for JWT tokens
# CRITICAL: Must be different from SECRET_KEY!
# Generate with: python utils/generate_secrets.py
JWT_SECRET_KEY=CHANGE_ME_TO_DIFFERENT_SECURE_RANDOM_VALUE

# JWT token expiration times (in seconds)
JWT_ACCESS_TOKEN_EXPIRES=3600        # 1 hour
JWT_REFRESH_TOKEN_EXPIRES=2592000    # 30 days

# ============================================================================
# Celery Task Queue Configuration
# ============================================================================

# Celery broker URL (Redis)
# For Docker: host is 'redis' (service name)
# For local: host is 'localhost'
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# For local development:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis URL for caching and session storage
REDIS_URL=redis://redis:6379/1

# For local development:
# REDIS_URL=redis://localhost:6379/1

# Optional: Redis password (uncomment for production)
# REDIS_PASSWORD=secure_redis_password_here

# ============================================================================
# Multi-tenancy Configuration
# ============================================================================

# Enable multi-tenant support (organizations)
MULTI_TENANT_ENABLED=True

# ============================================================================
# API Configuration
# ============================================================================

# API rate limiting (format: "requests/period")
# Examples: "100/hour", "1000/day", "10/minute"
API_RATE_LIMIT=100/hour

# Pagination - items per page
ITEMS_PER_PAGE=50

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Initial Admin User (First Run Only)
# ============================================================================
# These credentials are used to create the initial admin user
# Change the password immediately after first login!

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# WARNING: Change ADMIN_PASSWORD immediately after first login!
# ============================================================================
