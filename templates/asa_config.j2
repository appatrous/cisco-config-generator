{#
  Cisco ASA configuration template.

  Generates basic configuration for ASA devices.  Many ASA features
  differ significantly from IOS/NX‑OS; this template demonstrates
  static routes, VLAN assignment, OSPF, NTP and AAA.  Extend this
  template for additional ASA‑specific sections such as NAT.
#}

! Generated by Cisco Configuration Generator (ASA)

{# VLANs #}
{% if config.vlans %}
! VLANs (ASA uses subinterfaces)
{% for vlan in config.vlans %}
vlan {{ vlan.id }}
 nameif VLAN{{ vlan.id }}
 security-level 100
 no shutdown
{% endfor %}
{% endif %}

{# Static routes #}
{% if config.static_routes %}
! Static routes
{% for route in config.static_routes %}
{# ASA uses network mask and gateway; split prefix #}
{% set netaddr, prefix = route.destination.split('/') %}
route outside {{ netaddr }} {{ prefix }} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}
{% endfor %}
{% endif %}

{# OSPF #}
{% if config.ospf %}
! OSPF configuration
router ospf {{ config.ospf.process_id }}
{% if config.ospf.router_id %} router-id {{ config.ospf.router_id }}{% endif %}
{% for net in config.ospf.networks %}
 network {{ net.network }} area {{ net.area }}
{% endfor %}
 exit
{% endif %}

{# NTP #}
{% if config.ntp_servers %}
! NTP servers
{% for srv in config.ntp_servers %}
ntp server {{ srv }}
{% endfor %}
{% endif %}

{# AAA #}
{% if config.aaa %}
! AAA configuration
aaa authentication console LOCAL
{% if config.aaa.use_tacacs %}
! TACACS+ servers
{% for srv in config.aaa.tacacs_servers %}
aaa-server TAC{{ loop.index }} protocol tacacs+
 aaa-server TAC{{ loop.index }} (management) host {{ srv }}
   key cisco
 exit
{% endfor %}
{% endif %}

{% if config.aaa.use_radius %}
! RADIUS servers
{% for srv in config.aaa.radius_servers %}
aaa-server RAD{{ loop.index }} protocol radius
 aaa-server RAD{{ loop.index }} (management) host {{ srv }}
   key cisco
 exit
{% endfor %}
{% endif %}

{% if config.aaa.local_users %}
! Local users
{% for user in config.aaa.local_users %}
username {{ user.username }} password {{ user.password }} privilege {{ user.privilege }}
{% endfor %}
{% endif %}
{% endif %}

!
end