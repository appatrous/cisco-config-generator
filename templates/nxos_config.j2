{#
  Cisco NX‑OS configuration template.

  The template emits feature commands and standard configuration
  statements for NX‑OS devices based on the ``config`` data model.
  Extend this template to support additional protocols and features.
#}

! Generated by Cisco Configuration Generator (NX‑OS)

{# Enable features based on configuration #}
{% if config.vlans %}
feature vlan
{% endif %}
{% if config.ospf %}
feature ospf
{% endif %}
{% if config.ntp_servers %}
feature ntp
{% endif %}
{% if config.aaa and config.aaa.use_tacacs %}
feature tacacs+
{% endif %}
{% if config.aaa and config.aaa.use_radius %}
feature radius
{% endif %}

{# VLANs #}
{% if config.vlans %}
! VLANs
{% for vlan in config.vlans %}
vlan {{ vlan.id }}
{% if vlan.name %} name {{ vlan.name }}{% endif %}
 exit
{% endfor %}
{% endif %}

{# Static routes #}
{% if config.static_routes %}
! Static routes
{% for route in config.static_routes %}
ip route {{ route.destination }} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}
{% endfor %}
{% endif %}

{# OSPF #}
{% if config.ospf %}
! OSPF configuration
router ospf {{ config.ospf.process_id }}
{% if config.ospf.router_id %} router-id {{ config.ospf.router_id }}{% endif %}
{% for net in config.ospf.networks %}
 network {{ net.network }} area {{ net.area }}
{% endfor %}
 exit
{% endif %}

{# NTP #}
{% if config.ntp_servers %}
! NTP servers
{% for srv in config.ntp_servers %}
ntp server {{ srv }}
{% endfor %}
{% endif %}

{# AAA #}
{% if config.aaa %}
! AAA configuration
aaa authentication login default local
!
{% if config.aaa.use_tacacs %}
! TACACS+ servers
{% for srv in config.aaa.tacacs_servers %}
tacacs server TAC{{ loop.index }}
 address ipv4 {{ srv }}
 key cisco
 exit
{% endfor %}
aaa group server tacacs+ TACGROUP
{% for srv in config.aaa.tacacs_servers %}
 server name TAC{{ loop.index }}
{% endfor %}
 exit
aaa authentication login default group TACGROUP local
{% endif %}

{% if config.aaa.use_radius %}
! RADIUS servers
{% for srv in config.aaa.radius_servers %}
radius server RAD{{ loop.index }}
 address ipv4 {{ srv }}
 key cisco
 exit
{% endfor %}
aaa group server radius RADGROUP
{% for srv in config.aaa.radius_servers %}
 server name RAD{{ loop.index }}
{% endfor %}
 exit
aaa authentication login default group RADGROUP local
{% endif %}

{% if config.aaa.local_users %}
! Local users
{% for user in config.aaa.local_users %}
username {{ user.username }} password {{ user.password }} role network-admin
{% endfor %}
{% endif %}
!
{% endif %}

!
copy running-config startup-config