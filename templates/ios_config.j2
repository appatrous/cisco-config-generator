{#
  Cisco IOS configuration template.

  This template reads the ``config`` dictionary and constructs a
  configuration suitable for IOS devices.  Additional features can be
  added by extending the conditional blocks and loops below.
#}

! Generated by Cisco Configuration Generator (IOS)

{# VLAN configuration #}
{% if config.vlans %}
! VLAN definitions
{% for vlan in config.vlans %}
vlan {{ vlan.id }}
{% if vlan.name %} name {{ vlan.name }}{% endif %}
 exit
{% endfor %}
{% endif %}

{# Static routes #}
{% if config.static_routes %}
! Static routes
{% for route in config.static_routes %}
ip route {{ route.destination }} {{ route.next_hop }}{% if route.distance %} {{ route.distance }}{% endif %}
{% endfor %}
{% endif %}

{# OSPF #}
{% if config.ospf %}
! OSPF configuration
router ospf {{ config.ospf.process_id }}
{% if config.ospf.router_id %} router-id {{ config.ospf.router_id }}{% endif %}
{% for net in config.ospf.networks %}
 network {{ net.network }} area {{ net.area }}
{% endfor %}
 exit
{% endif %}

{# NTP servers #}
{% if config.ntp_servers %}
! NTP servers
{% for srv in config.ntp_servers %}
ntp server {{ srv }}
{% endfor %}
{% endif %}

{# AAA #}
{% if config.aaa %}
! AAA configuration
aaa new-model
!
{% if config.aaa.use_tacacs %}
! TACACS+ servers
{% for srv in config.aaa.tacacs_servers %}
tacacs server TAC{{ loop.index }}
 address ipv4 {{ srv }}
 key cisco
 exit
{% endfor %}
aaa group server tacacs+ TACGROUP
{% for srv in config.aaa.tacacs_servers %}
 server name TAC{{ loop.index }}
{% endfor %}
 exit
aaa authentication login default group TACGROUP local
{% endif %}

{% if config.aaa.use_radius %}
! RADIUS servers
{% for srv in config.aaa.radius_servers %}
radius server RAD{{ loop.index }}
 address ipv4 {{ srv }}
 key cisco
 exit
{% endfor %}
aaa group server radius RADGROUP
{% for srv in config.aaa.radius_servers %}
 server name RAD{{ loop.index }}
{% endfor %}
 exit
aaa authentication login default group RADGROUP local
{% endif %}

{% if config.aaa.local_users %}
! Local users
{% for user in config.aaa.local_users %}
username {{ user.username }} privilege {{ user.privilege }} secret {{ user.password }}
{% endfor %}
{% endif %}
!
{% endif %}

!
end