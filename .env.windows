# ============================================================================
# CISCO CONFIG GENERATOR - CONFIGURATION WINDOWS SIMPLIFIÉE
# ============================================================================
#
# Ce fichier contient UNIQUEMENT les paramètres nécessaires pour Windows
# Les dépendances avancées (PostgreSQL, Redis, Celery) sont désactivées
#
# INSTRUCTIONS:
# 1. Copiez ce fichier et renommez-le en ".env"
# 2. Modifiez les valeurs selon vos besoins
# 3. Ne partagez JAMAIS ce fichier (il contient des secrets)
#
# ============================================================================

# ============================================================================
# Configuration Flask de Base
# ============================================================================

# Environnement: development, production, testing
FLASK_ENV=development

# Mode debug (affiche les erreurs détaillées)
# IMPORTANT: Mettez False en production!
FLASK_DEBUG=True

# Clé secrète pour les sessions Flask
# GÉNÉREZ une nouvelle clé pour la production!
# Vous pouvez utiliser: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-windows

# Durée de vie de la session en secondes (3600 = 1 heure)
SESSION_LIFETIME=3600

# Taille maximale des fichiers uploadés (16777216 = 16 MB)
MAX_UPLOAD_SIZE=16777216

# ============================================================================
# Configuration du Serveur
# ============================================================================

# Port d'écoute du serveur (par défaut: 5000)
FLASK_RUN_PORT=5000

# Adresse d'écoute
# 127.0.0.1 = accessible uniquement depuis votre PC
# 0.0.0.0 = accessible depuis le réseau local
FLASK_RUN_HOST=127.0.0.1

# ============================================================================
# Dossiers de l'Application
# ============================================================================

# Dossier pour les fichiers uploadés
UPLOAD_FOLDER=uploads

# Dossier pour les templates de configuration
CONFIG_TEMPLATE_DIR=config_templates

# ============================================================================
# Logging (Journalisation)
# ============================================================================

# Niveau de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# Base de Données (DÉSACTIVÉE pour installation simple)
# ============================================================================

# Pour une utilisation simple, la base de données n'est PAS nécessaire
# L'application fonctionne en mode "stateless" (sans sauvegarde)
#
# Si vous voulez activer PostgreSQL plus tard:
# DATABASE_URL=postgresql://username:password@localhost:5432/cisco_config_generator

# ============================================================================
# Fonctionnalités Avancées (DÉSACTIVÉES)
# ============================================================================

# Multi-tenant: désactivé pour simplifier
MULTI_TENANT_ENABLED=False

# JWT Authentication: désactivé pour simplifier
# JWT_SECRET_KEY=not-required-for-basic-usage

# Celery Task Queue: désactivé (pas de Redis)
# CELERY_BROKER_URL=redis://localhost:6379/0

# Redis Cache: désactivé
# REDIS_URL=redis://localhost:6379/1

# ============================================================================
# API Configuration
# ============================================================================

# Limitation du nombre de requêtes (optionnel)
API_RATE_LIMIT=100/hour

# Nombre d'éléments par page (pagination)
ITEMS_PER_PAGE=50

# CORS - Origines autorisées (pour les API)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# Utilisateur Admin (Optionnel)
# ============================================================================

# Ces identifiants sont utilisés SI vous activez l'authentification
# Pour une utilisation simple, ce n'est PAS nécessaire

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ============================================================================
# RÉSUMÉ POUR WINDOWS
# ============================================================================
#
# Configuration MINIMALE requise:
#   ✅ FLASK_ENV=development
#   ✅ FLASK_DEBUG=True
#   ✅ SECRET_KEY=votre_cle
#   ✅ FLASK_RUN_PORT=5000
#
# Tout le reste est OPTIONNEL pour une utilisation basique!
#
# Pour démarrer:
#   1. Copiez ce fichier en ".env"
#   2. Lancez: python app.py
#   3. Ouvrez: http://localhost:5000
#
# ============================================================================
