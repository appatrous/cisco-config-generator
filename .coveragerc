[run]
# Coverage configuration

# Source directories
source = .

# Omit files/directories from coverage
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */site-packages/*
    */dist-packages/*
    */venv/*
    */env/*
    */.venv/*
    */migrations/*
    */alembic/*
    */setup.py
    */conftest.py
    */.pytest_cache/*
    */htmlcov/*
    */.coverage
    */.git/*
    */.github/*
    */node_modules/*
    */static/*
    */templates/*
    */frontend/*

# Branch coverage
branch = True

# Parallel execution
parallel = True

[report]
# Reporting options

# Precision of coverage percentage
precision = 2

# Show missing lines
show_missing = True

# Skip covered files
skip_covered = False

# Skip empty files
skip_empty = True

# Sort by
sort = Cover

# Fail under (minimum coverage percentage)
fail_under = 50

# Exclude lines from coverage
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:

    # Don't complain about abstract methods
    @abstract
    @abstractmethod

    # Don't complain about pass statements
    pass

[html]
# HTML report options
directory = htmlcov
title = Cisco Config Generator Coverage Report

[xml]
# XML report options (for CI/CD)
output = coverage.xml

[json]
# JSON report options
output = coverage.json
